{
  "name": "vouch-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Every model competes, the best render gets vouched. A Livepeer Agent multi-model shootout with blind, checklist-based grading and a public leaderboard.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ffmpeg-static",
      "sharp"
    ]
  }
}
