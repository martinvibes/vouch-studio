# Livepeer Agent API key (https://app.daydream.live). Optional: without it the
# server runs on Livepeer's keyless demo credits for its network address.
LIVEPEER_API_KEY=
LIVEPEER_MCP_URL=https://agent.livepeer.org/api/mcp

# Where runtime shootouts are written (mount a volume here in production).
DATA_DIR=./data

# Public-demo guards.
DAILY_SPEND_USD=8
SHOOTOUTS_PER_IP_PER_HOUR=6
MAX_CONCURRENT_SHOOTOUTS=2
